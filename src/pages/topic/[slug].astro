---
import Layout from '../../layouts/Layout.astro';
import TopicCard from '../../components/TopicCard.astro';
import { topics } from '../../data/topics';

export function getStaticPaths() {
  return topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
---

<Layout title={`${topic.name} — Madhu's Dream`}>
  <div class="pt-16 min-h-screen">
    <!-- Header -->
    <section class="py-14 px-4 relative overflow-hidden">
      <div class="absolute inset-0 opacity-40" style="background: linear-gradient(135deg, var(--theme-bg-gradient1), transparent, var(--theme-bg-gradient2));"></div>
      <div class="max-w-6xl mx-auto relative">
        <a
          href="/"
          class="inline-flex items-center font-medium mb-8 transition-colors hover-link"
          style="color: var(--theme-text-secondary);"
        >
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Blog
        </a>

        <!-- Topic switcher menu -->
        <nav class="flex flex-wrap gap-3 mb-10">
          {topics.map((t) => (
            <a
              href={`/topic/${t.slug}`}
              class="px-5 py-2 rounded-full text-sm font-semibold border transition-all"
              style={t.slug === topic.slug
                ? 'background: linear-gradient(135deg, var(--theme-primary-from), var(--theme-secondary-from)); color: #fff; border-color: transparent;'
                : 'background: var(--theme-card-bg); color: var(--theme-text-secondary); border-color: var(--theme-card-border);'}
            >
              {t.emoji} {t.name}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-4 mb-4">
          <span class="text-5xl">{topic.emoji}</span>
          <h1
            class="text-5xl md:text-6xl font-bold bg-clip-text text-transparent"
            style="background-image: linear-gradient(to right, var(--theme-primary-from), var(--theme-accent-from));"
          >
            {topic.name}
          </h1>
        </div>
        <p class="text-xl max-w-3xl" style="color: var(--theme-text-secondary);">{topic.tagline}</p>
        <p class="mt-3 text-sm font-semibold uppercase tracking-wider" style="color: var(--theme-text-tertiary);">
          {topic.posts.length} sub-blogs
        </p>
      </div>
    </section>

    <!-- Grid -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <!-- Grid search -->
      <div class="relative mb-8 max-w-md">
        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: var(--theme-text-tertiary);">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M11 18a7 7 0 100-14 7 7 0 000 14z" />
        </svg>
        <input
          id="grid-search"
          type="text"
          placeholder={`Search ${topic.name} sub-blogs…`}
          autocomplete="off"
          class="w-full pl-11 pr-4 py-3 rounded-xl border text-sm outline-none transition-colors"
          style="background: var(--theme-card-bg); border-color: var(--theme-card-border); color: var(--theme-text-primary);"
        />
      </div>

      <div id="grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {topic.posts.map((post, i) => (
          <TopicCard {...post} index={i} />
        ))}
      </div>

      <p id="grid-empty" class="hidden text-center py-16 text-lg" style="color: var(--theme-text-tertiary);">
        No sub-blogs match your search.
      </p>
    </section>

    <script>
      const gridSearch = document.getElementById('grid-search') as HTMLInputElement | null;
      const cards = Array.from(document.querySelectorAll('#grid .topic-card')) as HTMLElement[];
      const gridEmpty = document.getElementById('grid-empty');

      gridSearch?.addEventListener('input', () => {
        const q = gridSearch.value.toLowerCase().trim();
        let shown = 0;
        cards.forEach((c) => {
          const match = (c.dataset.search || '').includes(q);
          c.style.display = match ? '' : 'none';
          if (match) shown++;
        });
        gridEmpty?.classList.toggle('hidden', shown > 0);
      });
    </script>
  </div>
</Layout>

<style>
  .hover-link:hover { color: var(--theme-primary-from); }
  @keyframes slide-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-slide-up { animation: slide-up 0.5s ease-out forwards; opacity: 0; }
</style>
