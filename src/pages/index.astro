---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import BlogCard from '../components/BlogCard.astro';
import Sidebar from '../components/Sidebar.astro';

const blogPosts = [
  {
    id: 'llm-inference-optimization',
    title: 'LLM Inference Optimization: The Series',
    excerpt: 'Every LLM answers in two phases: prefill reads your prompt, decode writes the answer — and nearly every serving optimization targets one of the two. The whole series in reading order: the KV cache, the metrics, six techniques, and hands-on guides to vLLM and LLM Compressor.',
    date: 'July 25, 2026',
    readTime: '4 min read',
    category: 'LLM Inference',
    image: '/llm-inference/cover.svg',
    link: '/blog/llm-inference-optimization',
    fav: true,
  },
  {
    id: 'rag-the-whole-story',
    title: 'How RAG actually works, start to finish',
    excerpt: 'We built the most naive RAG system that could possibly work, then improved it one idea at a time — measuring every step on the same hard test. Some tricks delivered, some didn\'t. The same system went from mediocre to genuinely strong, and you\'ll understand why each step did what it did.',
    date: 'June 25, 2026',
    readTime: '16 min read',
    category: 'RAG · Overview',
    image: '/rag/cover.svg',
    link: '/blog/rag-the-whole-story',
    fav: true,
  },
  {
    id: 'frontend-llms',
    title: 'UI Out of Thin Air — What Frontend Engineers Will Actually Do After Gemma 4',
    excerpt: 'Frontend engineers are quietly worried that Claude, v0, and Cursor are eating the job. Wrong worry. Gemma 4 hit two runtimes the same week — browser and edge — and the frontier moved with it. UI assembled on the user\'s GPU from a sentence.',
    date: 'April 28, 2026',
    readTime: '14 min read',
    category: 'WebGPU / AI',
    image: '/frontend-llms/image1.png',
    link: '/blog/frontend-llms',
    fav: true,
  },
  {
    id: 'webgpu-llm',
    title: 'There\'s an LLM Running in Your Browser Right Now — No Internet, No API, No Credits',
    excerpt: 'You\'ve seen the screen: "0/3 credits available." Gemma 4\'s TurboQuant + PLE let a full LLM run in the browser — no internet after first load, no tokens, no credit wall. Full build walkthrough.',
    date: 'April 2025',
    readTime: '18 min read',
    category: 'WebGPU / AI',
    image: '/webgpullm/image1.png',
    link: '/blog/webgpu-llm',
    fav: true,
  },
  {
    id: 'thinking-in-agents',
    title: 'Thinking in Agents: The New Mental Model Every Developer Needs',
    excerpt: 'We used to write code that told computers what to do. Now we\'re writing code that tells agents what to think about.',
    date: 'March 13, 2026',
    readTime: '10 min read',
    category: 'AI Development',
    image: '/thinkingAgents/image1.png',
    link: '/blog/thinking-in-agents',
    fav: true,
  },
  {
    id: 'contentflow-cms',
    title: 'Building ContentFlow CMS in 2 Days with AI',
    excerpt: 'How I built an entire content management system using Level 4 AI development—SDK, CMS, server, and deployment—in just 32 hours.',
    date: 'March 2, 2026',
    readTime: '12 min read',
    category: 'AI Development',
    image: '/contentflow/image1.png',
    link: '/blog/contentflow-cms',
    fav: true,
  },
  {
    id: 'sdd',
    title: 'Spec-Driven Development: Building with AI',
    excerpt: 'The methodology behind building ContentFlow CMS in 32 hours. Learn how treating specifications as the primary artifact enables 3-10x productivity gains.',
    date: 'March 2, 2026',
    readTime: '12 min read',
    category: 'AI Development',
    image: '/contentflow/image2.png',
    link: '/blog/sdd',
    fav: true,
  },
  {
    id: 'wordstash',
    title: 'WordStash: Your Personal Vocabulary Companion',
    excerpt: 'Building a dead-simple iOS app for capturing and learning new words. From idea to App Store in one day.',
    date: 'February 28, 2026',
    readTime: '6 min read',
    category: 'iOS Development',
    image: '/wordstash/image1.png',
    link: '/blog/wordstash',
    fav: true,
  },
  {
    id: 'optionmantra',
    title: 'VIX Data Pipeline: A Practical Build',
    excerpt: 'Creating a reliable system to track VIX at 5-minute resolution, blending Yahoo Finance with Tastytrade live data.',
    date: 'February 27, 2026',
    readTime: '8 min read',
    category: 'Data Engineering',
    image: '/optionmantra/image2.png',
    link: '/blog/optionmantra',
    fav: true,
  },
];

const latestPosts = blogPosts.slice(0, 3);
const latestIds = new Set(latestPosts.map(p => p.id));
const favPosts = blogPosts.filter(p => p.fav && !latestIds.has(p.id));
---

<Layout title="Madhu's Dream - Building 100+ Apps">
  <div class="pt-16">
    <!-- Hero Section -->
    <Hero published={4} inProgress={1} goal={100} />

    <!-- Main Content with Sidebar -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="flex gap-12">
        <!-- Main Blog Content -->
        <div class="flex-1">
          <!-- Latest 3 -->
          <div class="mb-14">
            <h2 class="text-5xl font-bold mb-3" style="color: var(--theme-text-primary);">Latest</h2>
            <p class="text-lg" style="color: var(--theme-text-secondary);">Most recent stories</p>
          </div>

          <div class="space-y-10">
            {latestPosts.map((post, index) => (
              <BlogCard {...post} index={index} fav={post.fav} />
            ))}
          </div>

          <!-- Favourites / Featured -->
          {favPosts.length > 0 && (
          <div class="mt-20">
            <div class="mb-10 flex items-center gap-4">
              <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24" style="color: var(--theme-primary-from);"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              <h2 class="text-4xl font-bold" style="color: var(--theme-text-primary);">Featured</h2>
            </div>
            <div class="space-y-10">
              {favPosts.map((post, index) => (
                <BlogCard {...post} index={index} fav={true} />
              ))}
            </div>
          </div>
          )}

          <!-- About Section -->
          <div 
            class="mt-20 rounded-3xl p-12 border shadow-xl relative overflow-hidden"
            style="background: linear-gradient(135deg, var(--theme-bg-gradient1), var(--theme-bg-gradient3)); border-color: var(--theme-card-border);"
          >
            <div class="absolute inset-0 opacity-30" style="background: var(--theme-card-bg);"></div>
            <div class="relative">
              <h3 class="text-4xl font-bold mb-6" style="color: var(--theme-text-primary);">My Journey</h3>
              <!-- Personal story coming soon -->
              <p class="text-lg leading-relaxed mb-5 font-serif" style="color: var(--theme-text-secondary);">
                During a 5-day hospital stay, I built 2 complete apps using AI-driven development. 
                This is my mission to create 100+ apps and document the journey—sharing lessons, failures, and victories along the way.
              </p>
              <p 
                class="italic text-xl font-serif border-l-4 pl-6 py-2 rounded-r-xl"
                style="color: var(--theme-text-primary); border-color: var(--theme-primary-from); background: var(--theme-card-bg);"
              >
                "Every app is a story. Every story is a lesson. Every lesson is a legacy."
              </p>
              <div class="mt-8">
                <a 
                  href="/apps" 
                  class="inline-flex items-center px-8 py-4 text-white rounded-full font-semibold text-lg hover:shadow-2xl hover:scale-105 transition-all"
                  style="background: linear-gradient(135deg, var(--theme-primary-from), var(--theme-secondary-from), var(--theme-accent-from));"
                >
                  View All Apps
                  <svg class="w-6 h-6 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating Sidebar -->
        <Sidebar posts={blogPosts} totalApps={4} totalPosts={blogPosts.length} />
      </div>
    </section>
  </div>
</Layout>

<style>
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-slide-up {
    animation: slide-up 0.6s ease-out forwards;
    opacity: 0;
  }
</style>
