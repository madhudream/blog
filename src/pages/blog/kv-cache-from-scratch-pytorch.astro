---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/kv-cache-from-scratch-pytorch.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="Build the KV Cache from Scratch in PyTorch"
  date="July 25, 2026"
  readTime="7 min read"
  category="LLM Inference · Hands-on"
  description="Write the attention formula in four lines, implement the naive decode loop, count the wasted work, then add the KV cache and watch computations collapse from quadratic to linear."
>
  <Fragment set:html={content} />
</EssayPost>
