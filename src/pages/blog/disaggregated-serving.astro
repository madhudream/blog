---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/disaggregated-serving.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="Disaggregated Serving: Splitting Prefill and Decode Across GPUs"
  date="July 25, 2026"
  readTime="3 min read"
  category="LLM Inference · Technique"
  description="Run prefill on one pool of GPUs and decode on another, shipping the KV cache between them, so each phase hits its own latency target."
>
  <Fragment set:html={content} />
</EssayPost>
