---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/tokens-how-ai-usage-is-measured.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="Tokens: How AI Usage Is Measured, Metered, and Billed"
  date="August 24, 2026"
  readTime="9 min read"
  category="Numbers & Scaling · Foundations"
  description="What a token is, the two meters every AI API runs, why output costs 4–8x more than input, how prompt caching changes the bill, and the worked cost of one call and a whole season."
>
  <Fragment set:html={content} />
</EssayPost>
