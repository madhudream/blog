---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/radix-attention-from-scratch-pytorch.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="Build RadixAttention from Scratch in PyTorch"
  date="July 25, 2026"
  readTime="9 min read"
  category="LLM Inference · Hands-on"
  description="SGLang's RadixAttention in ~60 lines of plain PyTorch: a cache store, a prefix search, and the four-step pattern — traverse, reuse, compute, store — measured on a real RAG workload."
>
  <Fragment set:html={content} />
</EssayPost>
