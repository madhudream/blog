---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/rag-the-whole-story.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

// GitHub-style slugs on headings so the table-of-contents anchors jump correctly.
const slugify = (s) =>
  s.toLowerCase().replace(/[^\w\s-]/g, '').trim().replace(/\s+/g, '-');
const renderer = new marked.Renderer();
renderer.heading = ({ tokens, depth }) => {
  const text = tokens.map((t) => t.text ?? t.raw ?? '').join('');
  const id = slugify(text);
  return `<h${depth} id="${id}">${marked.parseInline(text)}</h${depth}>`;
};

const content = await marked.parse(markdownToRender, { renderer });
---

<EssayPost
  title="How RAG actually works, start to finish"
  date="June 25, 2026"
  readTime="15 min read"
  category="RAG · Overview"
  description="The map for the whole series: a naive RAG system improved one idea at a time, every step measured on the same hard test."
>
  <Fragment set:html={content} />
</EssayPost>
