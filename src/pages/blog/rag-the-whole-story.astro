---
import BlogPost from '../../layouts/BlogPost.astro';
import RagRoadmap from '../../components/RagRoadmap.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/rag-the-whole-story.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

// GitHub-style slugs on headings so the sidebar TOC anchors jump correctly.
const slugify = (s) =>
  s.toLowerCase().replace(/[^\w\s-]/g, '').trim().replace(/\s+/g, '-');
const renderer = new marked.Renderer();
renderer.heading = ({ tokens, depth }) => {
  const text = tokens.map((t) => t.text ?? t.raw ?? '').join('');
  const id = slugify(text);
  return `<h${depth} id="${id}">${marked.parseInline(text)}</h${depth}>`;
};

const content = await marked.parse(markdownToRender, { renderer });

const tocItems = [
  { id: 'the-test-and-the-villain',                label: 'The test & the villain' },
  { id: 'how-do-you-actually-measure-a-rag-system', label: 'Measuring RAG' },
  { id: 'what-does-naive-rag-look-like',           label: 'The naive baseline' },
  { id: 'how-does-chunking-change-rag',            label: 'Chunking' },
  { id: 'how-does-hybrid-search-work',             label: 'Hybrid search' },
  { id: 'how-does-a-reranker-work',                label: 'Reranking' },
  { id: 'how-does-query-rewriting-help-and-hurt',  label: 'Query rewriting' },
  { id: 'how-does-contextual-retrieval-work',      label: 'Contextual retrieval' },
  { id: 'how-does-a-semantic-cache-work',          label: 'Semantic caching' },
  { id: 'the-whole-climb-in-one-table',            label: 'The full climb' },
  { id: 'what-the-series-is-really-teaching',      label: 'What it teaches' },
  { id: 'whats-next',                              label: "What's next" },
];
---

<BlogPost
  title="How RAG actually works, start to finish"
  date="June 25, 2026"
  readTime="15 min read"
  category="RAG · Overview"
  emoji="🧗"
  description="A gentle, chapter-by-chapter tour of Retrieval-Augmented Generation — start naive, measure it, then climb one measured step at a time from Novice to Ninja."
  screenshots={[]}
  tocItems={tocItems}
>
  <RagRoadmap />
  <Fragment set:html={content} />
</BlogPost>
