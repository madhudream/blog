---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/numbers-every-ai-engineer-should-know.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="Numbers Every AI Engineer Should Know"
  date="July 25, 2026"
  readTime="10 min read"
  category="LLM Inference · Reference"
  description="The back-of-envelope numbers behind every LLM system-design decision: token sizes, bytes per parameter, what T4 to H100 actually offer, decode speed limits, and what a million tokens costs."
>
  <Fragment set:html={content} />
</EssayPost>
