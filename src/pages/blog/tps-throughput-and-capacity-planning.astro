---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/tps-throughput-and-capacity-planning.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="TPS and Capacity Planning: From User Traffic to a GPU Count"
  date="August 24, 2026"
  readTime="10 min read"
  category="Numbers & Scaling · Foundations"
  description="The five-multiplication chain from daily users to calls per minute, tokens per second, concurrency, and a GPU count — plus Little's Law, percentile sizing, the API-vs-self-host break-even, and an autoscaling calendar."
>
  <Fragment set:html={content} />
</EssayPost>
