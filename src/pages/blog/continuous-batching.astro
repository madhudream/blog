---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/continuous-batching.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="Continuous Batching in LLM Serving"
  date="July 25, 2026"
  readTime="3 min read"
  category="LLM Inference · Technique"
  description="Refill a finished request's slot at every decode step instead of waiting for the whole batch. The main throughput lever, on by default in modern engines."
>
  <Fragment set:html={content} />
</EssayPost>
