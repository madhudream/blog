---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/renting-gpus-startups-secure-vs-nonsecure.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="Renting GPUs: The Startup Path, and Which Workloads Belong on Which Tier"
  date="August 24, 2026"
  readTime="10 min read"
  category="Numbers & Scaling · Buying capacity"
  description="Neoclouds, marketplaces, serverless GPUs, and open-model token APIs; the startup ladder from zero commitment to reserved fleets; and the data classification that decides which tier each workload may use."
>
  <Fragment set:html={content} />
</EssayPost>
