---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/inference-stack-qwen-vllm.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="The Inference Stack: How an Open Model on vLLM Cut Cost 10x"
  date="August 24, 2026"
  readTime="11 min read"
  category="Numbers & Scaling · Serving"
  description="Qwen's mixture-of-experts math, PagedAttention, continuous batching, prefix caching, speculative decoding, and FP8 — how the layers compound from a $0.0136 API answer to ~$0.0013 self-hosted."
>
  <Fragment set:html={content} />
</EssayPost>
