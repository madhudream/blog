---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/llm-compressor-quantization.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="Quantizing a Model with LLM Compressor"
  date="July 25, 2026"
  readTime="8 min read"
  category="LLM Inference · Hands-on"
  description="Apply a GPTQ W4A16 recipe with one oneshot call, measure the size win and the perplexity cost, and serve the result directly with vLLM."
>
  <Fragment set:html={content} />
</EssayPost>
