---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/llm-inference-optimization.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="Prefill vs Decode: LLM Inference Optimization"
  date="July 5, 2026"
  readTime="34 min read"
  category="LLM Inference"
  description="Prefill reads your prompt, decode writes the answer — and they hit opposite bottlenecks. How the KV cache bridges them, and the optimizations that speed each phase up."
>
  <Fragment set:html={content} />
</EssayPost>
