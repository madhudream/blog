---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/prefill-vs-decode.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="Prefill vs Decode: The Two Phases of LLM Inference"
  date="July 25, 2026"
  readTime="14 min read"
  category="LLM Inference · Foundations"
  description="Prefill reads your whole prompt in one compute-bound pass; decode writes the answer one memory-bound token at a time. This single split explains nearly every inference optimization."
>
  <Fragment set:html={content} />
</EssayPost>
