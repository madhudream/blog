---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/azure-payg-vs-ptu-reserved.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="Azure: Pay-As-You-Go vs Provisioned Throughput (PTU), with a Season of Real Traffic"
  date="August 24, 2026"
  readTime="11 min read"
  category="Numbers & Scaling · Buying capacity"
  description="The two ways Azure sells model capacity, the PTU formula worked end to end on a season of daily traffic, hourly vs monthly vs yearly break-evens, and the layered buying strategy."
>
  <Fragment set:html={content} />
</EssayPost>
