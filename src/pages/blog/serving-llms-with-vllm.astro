---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/serving-llms-with-vllm.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="Serving LLMs with vLLM: A Practical Guide"
  date="July 25, 2026"
  readTime="10 min read"
  category="LLM Inference · Hands-on"
  description="Launch a vLLM server, query it with the OpenAI client, watch continuous batching and prefix caching through live Prometheus metrics, and benchmark with GuideLLM and lm_eval."
>
  <Fragment set:html={content} />
</EssayPost>
