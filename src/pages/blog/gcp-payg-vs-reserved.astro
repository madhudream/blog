---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/gcp-payg-vs-reserved.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="GCP: Pay-As-You-Go, Provisioned Throughput, and Reserved GPUs"
  date="August 24, 2026"
  readTime="9 min read"
  category="Numbers & Scaling · Buying capacity"
  description="Vertex AI per-token pricing and GSUs, the A2/A3/G2 machine families, committed-use discounts, Spot VMs, DWS, and the scale-to-zero discipline — the same break-even arithmetic on Google Cloud."
>
  <Fragment set:html={content} />
</EssayPost>
