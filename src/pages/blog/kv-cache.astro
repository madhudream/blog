---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/kv-cache.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="The KV Cache: The Bridge Between Prefill and Decode"
  date="July 25, 2026"
  readTime="6 min read"
  category="LLM Inference · Foundations"
  description="The store of Keys and Values that lets an LLM generate each token without recomputing its entire past — and the biggest consumer of GPU memory in serving."
>
  <Fragment set:html={content} />
</EssayPost>
