---
import EssayPost from '../../layouts/EssayPost.astro';
import { marked } from 'marked';
import markdownContent from '../../../content/gpu-guide-a100-h100.md?raw';

// Strip YAML frontmatter + the h1 title line — both rendered by the layout header
const lines = markdownContent.split('\n');
const contentStart = lines.findIndex(l => l.startsWith('# '));
const markdownToRender = lines.slice(contentStart + 1).join('\n');

const content = await marked.parse(markdownToRender);
---

<EssayPost
  title="A100, H100, and Friends: A GPU Handbook for Infrastructure Engineers"
  date="August 24, 2026"
  readTime="12 min read"
  category="Numbers & Scaling · Foundations"
  description="What the cards actually are — memory, bandwidth, tensor cores, NVLink, SXM vs PCIe, MIG — the full lineup from T4 to B200, what fits where, the one division that predicts serving speed, and cloud prices."
>
  <Fragment set:html={content} />
</EssayPost>
